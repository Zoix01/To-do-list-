{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "pwa-assets.config.ts",
    "scripts",
    "src/shared",
    "src/worker/password.ts",
    "src/**/*.test.ts"
  ]
}
